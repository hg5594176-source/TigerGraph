# ============================================================
# TigerGraph Agentic Fraud Investigation — Environment Config
# Compatible with tigergraph-mcp (https://github.com/tigergraph/tigergraph-mcp)
# ============================================================
# Copy this to .env and fill in your credentials.
# NEVER commit .env to version control.

# --- TigerGraph Savanna / Connection Settings ---
TG_HOST=https://YOUR_SUBDOMAIN.tgcloud.io
TG_GRAPHNAME=HHGOA_IEEE
TG_USERNAME=tigergraph
TG_PASSWORD=YOUR_PASSWORD
TG_RESTPP_PORT=443
TG_GS_PORT=443
TG_TGCLOUD=true

# Optional: Token-based Auth (alternative to username/password)
# TG_SECRET=YOUR_GSQL_SECRET
# TG_API_TOKEN=YOUR_API_TOKEN

# --- tigergraph-mcp Server Settings ---
TG_DEFAULT_PROFILE=default
# TG_ALLOWED_TOOLS=schema,query,vector
# TG_BLOCKED_TOOLS=drop_graph,clear_graph_data
# TG_LOG_TOOL_CALLS=false

# --- LLM Provider (Google Gemini free tier) ---
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
LLM_MODEL=gemini-2.0-flash

# --- Embedding Model ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Agent Config ---
CONFIDENCE_THRESHOLD=0.25
MAX_EVIDENCE_LOOPS=5

# --- Data Paths ---
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
